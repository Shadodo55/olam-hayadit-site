{
  "name": "olam-hayadit-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sanity Studio (content admin) for the Olam HaYadit catalog site",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "samples:remove": "sanity exec scripts/remove-samples.ts --with-user-token",
    "assets:cleanup": "sanity exec scripts/cleanup-assets.ts --with-user-token --",
    "seed:content": "sanity exec scripts/seed-content.ts --with-user-token"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@sanity/vision": "6.24.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.24.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    }
  }
}
