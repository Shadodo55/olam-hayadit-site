{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olam-hayadit-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Static pages from `next build` (output: "export"). Asset requests are free
  // and do not count towards the Worker request quota.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only API calls run the Worker code; everything else is served as a static file.
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // Copies of form inquiries (the store gets each one by email). Deleted after
  // 12 months by the daily cron below. Never put personal data in Sanity.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "olam-hayadit-inquiries",
      "database_id": "985537cf-92e3-4a66-9e66-6b12f6056a75",
      "migrations_dir": "worker/migrations",
    },
  ],
  // At most 3 form posts per minute from one IP address.
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  // Daily at 03:30 UTC: delete inquiry copies older than 12 months.
  "triggers": { "crons": ["30 3 * * *"] },
  // Secrets (set with `wrangler secret put`, never in this file):
  // RESEND_API_KEY, INQUIRY_TO_EMAIL, TURNSTILE_SECRET_KEY, INQUIRY_FROM_EMAIL (optional)
}
