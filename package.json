{
  "name": "olam-hayadit-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "next typegen && tsc --noEmit && tsc -p worker --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "prebuild": "node -e \"require('fs').rmSync('.next/cache/fetch-cache',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@sanity/client": "8.17.0",
    "@sanity/image-url": "2.2.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261122.2",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "serve": "14.2.8",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true,
    "@parcel/watcher": false,
    "@swc/core": false
  },
  "engines": {
    "node": ">=22"
  }
}
