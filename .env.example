# Copy to .env.local for local development. Never commit real secrets.

# Public site URL (used for canonical links, hreflang, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep "false" until launch: pages are noindex while the site is under construction
NEXT_PUBLIC_ALLOW_INDEXING=false

# Sanity (public dataset, read-only access needs no token)
NEXT_PUBLIC_SANITY_PROJECT_ID=gntr6ikv
NEXT_PUBLIC_SANITY_DATASET=production

# Turnstile site key (public, used at build time). Unset = Cloudflare's
# always-pass test key; the Worker refuses inquiries until the secret is set.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Forms: Wrangler secrets (`npx wrangler secret put NAME`), never here ---
# RESEND_API_KEY=
# INQUIRY_TO_EMAIL=          # the store's address (not given yet)
# TURNSTILE_SECRET_KEY=
# INQUIRY_FROM_EMAIL=        # optional; default onboarding@resend.dev until a domain exists

# --- CI only (GitHub Actions secrets) ---
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
